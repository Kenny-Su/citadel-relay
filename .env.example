# Required: use a unique, randomly generated value of at least 16 characters.
RELAY_ADMIN_PASSPHRASE=replace-with-a-long-random-secret

# Host port published by Docker Compose.
RELAY_PORT=3001

# Keep secure cookies enabled when the relay is served over HTTPS.
RELAY_ADMIN_SECURE_COOKIES=true

# Set to true only when running behind a trusted TLS reverse proxy.
RELAY_TRUST_PROXY=false

# Optional: set to summary or payload. Leave empty to disable traffic logging.
RELAY_TRAFFIC_LOG=
