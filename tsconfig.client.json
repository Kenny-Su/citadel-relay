{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/admin/client/**/*.ts",
    "src/admin/client/**/*.tsx",
    "tests/admin/**/*.test.tsx",
    "vite.config.ts"
  ]
}
